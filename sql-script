STEP 4: Advanced SQL Queries

1. Total Revenue
SELECT SUM(amount) AS total_revenue FROM Payment;

2. Most Popular Event
SELECT e.title, COUNT(t.ticket_id) AS tickets_sold
FROM Ticket t
JOIN Event e ON t.event_id = e.event_id
GROUP BY e.title
HAVING tickets_sold = (
    SELECT MAX(ticket_count)
    FROM (
        SELECT COUNT(*) AS ticket_count
        FROM Ticket
        GROUP BY event_id
    ) AS sub
);

3. User Booking History
SELECT u.name, b.booking_id, b.status
FROM `Users` u
JOIN Booking b ON u.user_id = b.user_id;

4. Revenue per Event
SELECT e.title, SUM(p.amount) AS revenue
FROM Event e
JOIN Ticket t ON e.event_id = t.event_id
JOIN Payment p ON t.booking_id = p.booking_id
GROUP BY e.title;

5. Canceled Tickets
SELECT * FROM Ticket WHERE status = 'canceled';

6. Subquery Example
SELECT name FROM Users
WHERE user_id IN (
    SELECT user_id FROM Booking WHERE status = 'confirmed'
);










